{
 "s1": {
  "dur": 16.353,
  "lufsIn": -24.82,
  "speechStart": 0,
  "speechEnd": 16.353,
  "chunks": [
   {
    "text": "It's 10 p.m. on a Saturday.",
    "start": 0,
    "end": 1.668
   },
   {
    "text": "Wall Street is asleep…",
    "start": 2.082,
    "end": 3.334
   },
   {
    "text": "but on BNB Chain, the stock market never closes.",
    "start": 3.946,
    "end": 7.14
   },
   {
    "text": "People are still trading NVIDIA.",
    "start": 7.688,
    "end": 9.36
   },
   {
    "text": "Lenders are still lending against it.",
    "start": 9.853,
    "end": 11.577
   },
   {
    "text": "So here's the question nobody can answer:",
    "start": 12.121,
    "end": 14.131
   },
   {
    "text": "what is it actually worth?",
    "start": 14.636,
    "end": 16.353
   }
  ],
