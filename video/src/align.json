 "s2": {
  "dur": 24.033,
  "lufsIn": -24.69,
  "speechStart": 0,
  "speechEnd": 23.775,
  "chunks": [
   {
    "text": "A week has 168 hours.",
    "start": 0,
    "end": 2.333
   },
   {
    "text": "The US market sets a real price for 32.5 of them.",
    "start": 2.881,
    "end": 6.259
   },
   {
    "text": "From Friday's close to Monday's bell, that's 65 hours in the dark…",
    "start": 6.885,
    "end": 11.045
   },
   {
    "text": "and 62% of bStocks' July volume traded while US markets were closed.",
    "start": 11.631,
    "end": 16.453
   },
   {
    "text": "When the market closes, the reference feeds stop updating.",
    "start": 17.026,
    "end": 20.08
   },
   {
    "text": "What's left is each token's own thin weekend trading.",
    "start": 20.649,
    "end": 23.775
   }
  ],
  "speech": [
