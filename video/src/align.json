  "lufsIn": -24.1,
  "speechStart": 0,
  "speechEnd": 17.568,
  "chunks": [
   {
    "text": "So that's what lenders read.",
    "start": 0,
    "end": 1.542
   },
   {
    "text": "Ask Venus what NVIDIA is worth tonight, and you get one number:",
    "start": 2.06,
    "end": 5.618
   },
   {
    "text": "the token's own trading price.",
    "start": 6.067,
    "end": 7.726
   },
   {
    "text": "We checked every dark weekend since June.",
    "start": 8.319,
    "end": 10.467
   },
   {
    "text": "That number called Monday's open barely better than Friday's close…",
    "start": 11.068,
    "end": 14.626
   },
   {
    "text": "and it comes with NO error bar at all.",
    "start": 15.215,
    "end": 17.568
   }
  ],
