    "text": "No wallet.",
    "start": 9.747,
    "end": 10.334
   },
   {
    "text": "No sign-up.",
    "start": 10.666,
    "end": 11.328
   },
   {
    "text": "Change the forecast by a single cent…",
    "start": 12.008,
    "end": 14.057
   },
   {
    "text": "and the check fails.",
    "start": 14.733,
    "end": 15.773
   },
   {
    "text": "On-chain.",
