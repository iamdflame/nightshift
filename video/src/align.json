 "s4": {
  "dur": 30.433,
  "lufsIn": -24.31,
  "speechStart": 0.216,
  "speechEnd": 30.226,
  "chunks": [
   {
    "text": "Meet the night shift.",
    "start": 0.216,
    "end": 1.436
   },
   {
    "text": "Three forecasters, each with its own on-chain identity.",
    "start": 1.811,
    "end": 5.374
   },
   {
    "text": "Anchor holds on to Friday's close.",
    "start": 5.863,
    "end": 7.818
   },
   {
    "text": "Echo listens to the live market.",
    "start": 8.337,
    "end": 9.973
   },
   {
    "text": "And NFV, our model, reads every signal through the night.",
    "start": 10.556,
    "end": 15.033
   },
   {
    "text": "Every 30 minutes, each one seals its forecast for all 91 stocks…",
    "start": 15.775,
    "end": 20.133
   },
   {
    "text": "the price at the next open, and a 90% range…",
    "start": 20.632,
    "end": 23.449
   },
   {
    "text": "into a contract on BNB Chain.",
    "start": 23.932,
    "end": 26.101
   },
   {
    "text": "Once it's sealed, nobody can change it.",
    "start": 26.66,
    "end": 29.025
   },
   {
    "text": "Not even us.",
    "start": 29.378,
    "end": 30.226
   }
  ],
