# Copy to .env and fill in. .env and keys/ are gitignored — back them up together.
NIGHTSHIFT_KEY_PASSWORD=          # ≥12 chars; unlocks the agent keystores in keys/
BINANCE_WEB3_API_KEY=             # Binance Web3 developer portal, all capability domains
BINANCE_WEB3_SECRET_KEY=
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
ANTHROPIC_API_KEY=                # optional: Newsdesk forecaster
NIGHTSHIFT_DB=data/tape.sqlite    # optional: tape location
PORT=8787                         # optional: API port
